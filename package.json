{
  "name": "haiyiba-lol-helper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n frontend,bridge,kb -c blue,green,yellow \"vite --host\" \"cd bridge && pnpm run dev\" \"cd knowledge-server && pnpm run dev\"",
    "dev:frontend": "vite --host",
    "dev:bridge": "cd bridge && pnpm run dev",
    "dev:kb": "cd knowledge-server && pnpm run dev",
    "dev:lan": "echo \"Usage: BRIDGE_URL=http://<Windows IP>:3517 pnpm run dev:frontend\"",
    "fetch-assets": "cd knowledge-server && npx tsx ../scripts/fetch-assets.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.4",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
